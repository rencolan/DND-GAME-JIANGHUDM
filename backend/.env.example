# Shared
DEFAULT_BRIDGE_ID=main

# Remote service
PORT=8787
CLIENT_API_KEY=replace-with-a-strong-client-key
BRIDGE_SECRET=replace-with-a-separate-bridge-secret
REQUEST_TIMEOUT_MS=120000

# Local bridge
REMOTE_HTTP_BASE=https://your-backend.example.com
REMOTE_WS_URL=wss://your-backend.example.com/ws/bridge
BRIDGE_ID=main
KOBOLD_BASE_URL=http://127.0.0.1:5001/v1/chat/completions
KOBOLD_MODEL=your-local-model-name
HEARTBEAT_INTERVAL_MS=15000
RECONNECT_DELAY_MS=3000
LOCAL_REQUEST_TIMEOUT_MS=120000

